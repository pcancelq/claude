# Copy to hexstrike.env and edit. Read by start-server.sh and the config
# generator; hexstrike.env itself is gitignored so local settings stay local.

# Port the API server listens on.
HEXSTRIKE_PORT=8888

# API keys for the OSINT/cloud integrations that need them. Leave blank to
# disable the corresponding tools. NEVER commit real values.
# SHODAN_API_KEY=
# CENSYS_API_ID=
# CENSYS_API_SECRET=
# VIRUSTOTAL_API_KEY=
