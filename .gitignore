# HexStrike: upstream source, virtualenv and machine-specific config
hexstrike/vendor/
hexstrike/hexstrike-env/
hexstrike/configs/generated/
hexstrike/hexstrike.env

# Local client config backups written by generate-client-config.py --install
*.bak-*

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# hexstrike runtime state (pid, logs)
hexstrike/.run/

# Project-scoped MCP config copied out of configs/generated/. Machine-specific
# absolute paths, so it must not be committed - regenerate it per machine with
# `hexstrike connect`.
.mcp.json
